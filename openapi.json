{
  "openapi": "3.0.3",
  "info": {
    "title": "Auth Login & Protect API",
    "version": "1.0.0",
    "description": "A small Express API that delegates user accounts to Supabase Auth and guards its own routes with the JWTs it hands out.\n\n**How to authenticate:** `POST /auth/login` returns an `access_token`. Click the **Authorize** button at the top of this page, paste the token (without the `Bearer ` prefix), and the padlock will unlock every protected route."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "tags": [
    { "name": "auth", "description": "Sign up, log in and log out" },
    { "name": "public", "description": "Open endpoints, no token required" },
    { "name": "protected", "description": "Bearer-token endpoints" }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "getRoot",
        "summary": "Health check",
        "description": "Proves the server is up. Requires no authentication.",
        "tags": ["public"],
        "responses": {
          "200": {
            "description": "Server is running",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RootMessage" }
              }
            }
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "operationId": "signup",
        "summary": "Create a new user account",
        "description": "Registers the user through Supabase Auth. The project's \"Confirm email\" setting decides whether a session is returned immediately.",
        "tags": ["auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Credentials" },
              "examples": {
                "default": { "value": { "email": "test@example.com", "password": "password123" } }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SignupResponse" }
              }
            }
          },
          "400": {
            "description": "Missing email/password, or Supabase rejected the signup",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "examples": {
                  "missingField": { "value": { "error": "Email and password are required" } }
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Authenticate a user and receive tokens",
        "tags": ["auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Credentials" },
              "examples": {
                "default": { "value": { "email": "test@example.com", "password": "password123" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated - store the access_token for protected calls",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenPair" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MissingCredentials" },
          "401": {
            "description": "Invalid login credentials",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "examples": {
                  "invalid": { "value": { "error": "Invalid login credentials" } }
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Terminate the session behind the presented token",
        "description": "Revokes this session. Afterwards the access token is rejected by the protected routes and the refresh token can no longer be exchanged.",
        "tags": ["auth"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "Signed out - no body" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/public/info": {
      "get": {
        "operationId": "getPublicInfo",
        "summary": "Read public, unprotected data",
        "tags": ["public"],
        "responses": {
          "200": {
            "description": "Public message",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PublicInfo" }
              }
            }
          }
        }
      }
    },
    "/protected/profile": {
      "get": {
        "operationId": "getProfile",
        "summary": "Read private user profile data",
        "description": "Verifies the bearer token with Supabase, then returns the caller's own metadata.",
        "tags": ["protected"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Verified user metadata",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProfileResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/protected/dashboard": {
      "get": {
        "operationId": "getDashboard",
        "summary": "Read the private dashboard",
        "description": "Second route behind the same `requireAuth` middleware - it has no token handling of its own.",
        "tags": ["protected"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Greeting for the verified user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Paste the `access_token` returned by `POST /auth/login`, without the `Bearer ` prefix."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing, malformed, invalid or expired token",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "examples": {
              "missingToken": { "value": { "error": "Access token required" } },
              "invalidToken": { "value": { "error": "Invalid or expired token" } }
            }
          }
        }
      },
      "MissingCredentials": {
        "description": "Email or password missing from the request body",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "examples": {
              "missingField": { "value": { "error": "Email and password are required" } }
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      },
      "RootMessage": {
        "type": "object",
        "properties": { "message": { "type": "string", "example": "Auth Login & Protect API is running." } }
      },
      "PublicInfo": {
        "type": "object",
        "properties": { "message": { "type": "string", "example": "Welcome stranger! This info is public." } }
      },
      "Credentials": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "test@example.com" },
          "password": { "type": "string", "format": "password", "example": "password123" }
        }
      },
      "AuthUser": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "aud": { "type": "string" },
          "role": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "email_confirmed_at": { "type": "string", "format": "date-time", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "SignupResponse": {
        "type": "object",
        "properties": { "user": { "$ref": "#/components/schemas/AuthUser" } }
      },
      "TokenPair": {
        "type": "object",
        "required": ["access_token", "refresh_token"],
        "properties": {
          "access_token": { "type": "string", "description": "Send as `Authorization: Bearer <access_token>`" },
          "refresh_token": { "type": "string", "description": "Exchange for a new access token once it expires" }
        }
      },
      "ProfileUser": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "ProfileResponse": {
        "type": "object",
        "properties": { "user": { "$ref": "#/components/schemas/ProfileUser" } }
      },
      "DashboardResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Welcome back, test@example.com." },
          "user": { "$ref": "#/components/schemas/ProfileUser" }
        }
      }
    }
  }
}
